{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "paulinca",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "paulinca"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "paullinca.com", "custom_domain": true },
    { "pattern": "www.paullinca.com", "custom_domain": true }
  ]
}
